{
    "name": "tyhpdef/symfony-messenger-impl",
    "description": "Implementation package for tyhpdef/symfony-messenger. Require tyhpdef/symfony-messenger, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "7.4.19.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/psr-log": "@dev",
                "tyhpdef/symfony-clock": "@dev",
                "tyhpdef/psr-clock": "@dev",
                "tyhpdef/psr-container": "@dev",
                "tyhpdef/psr-event-dispatcher": "@dev",
                "tyhpdef/symfony-validator": "@dev",
                "tyhpdef/symfony-translation-contracts": "@dev",
                "tyhpdef/psr-cache": "@dev",
                "tyhpdef/symfony-http-client-contracts": "@dev",
                "tyhpdef/symfony-service-contracts": "@dev",
                "tyhpdef/php-ext-simplexml": "@dev",
                "tyhpdef/symfony-error-handler": "@dev",
                "tyhpdef/symfony-var-dumper": "@dev",
                "tyhpdef/symfony-serializer": "@dev",
                "tyhpdef/symfony-property-access": "@dev",
                "tyhpdef/symfony-property-info": "@dev",
                "tyhpdef/symfony-type-info": "@dev",
                "tyhpdef/symfony-string": "@dev",
                "tyhpdef/php-ext-dom": "@dev",
                "tyhpdef/php-ext-bcmath": "@dev",
                "tyhpdef/php-ext-gmp": "@dev",
                "tyhpdef/symfony-console": "@dev",
                "tyhpdef/symfony-event-dispatcher-contracts": "@dev",
                "tyhpdef/symfony-http-foundation": "@dev",
                "tyhpdef/php-ext-session": "@dev",
                "tyhpdef/php-ext-pdo": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/symfony-messenger"
        }
    },
    "require": {
        "php": ">=8.2",
        "symfony/messenger": "7.4.19"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-log": "@dev",
        "tyhpdef/symfony-clock": "@dev",
        "tyhpdef/psr-clock": "@dev",
        "tyhpdef/psr-container": "@dev",
        "tyhpdef/psr-event-dispatcher": "@dev",
        "tyhpdef/symfony-validator": "@dev",
        "tyhpdef/symfony-translation-contracts": "@dev",
        "tyhpdef/psr-cache": "@dev",
        "tyhpdef/symfony-http-client-contracts": "@dev",
        "tyhpdef/symfony-service-contracts": "@dev",
        "tyhpdef/php-ext-simplexml": "@dev",
        "tyhpdef/symfony-error-handler": "@dev",
        "tyhpdef/symfony-var-dumper": "@dev",
        "tyhpdef/symfony-serializer": "@dev",
        "tyhpdef/symfony-property-access": "@dev",
        "tyhpdef/symfony-property-info": "@dev",
        "tyhpdef/symfony-type-info": "@dev",
        "tyhpdef/symfony-string": "@dev",
        "tyhpdef/php-ext-dom": "@dev",
        "tyhpdef/php-ext-bcmath": "@dev",
        "tyhpdef/php-ext-gmp": "@dev",
        "tyhpdef/symfony-console": "@dev",
        "tyhpdef/symfony-event-dispatcher-contracts": "@dev",
        "tyhpdef/symfony-http-foundation": "@dev",
        "tyhpdef/php-ext-session": "@dev",
        "tyhpdef/php-ext-pdo": "@dev"
    }
}
